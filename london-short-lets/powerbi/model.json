  "measures": [
    {
      "name": "Metric Value",
      "table": "Metric Values",
      "folder": "Generic",
      "format": "#,0.###",
      "dax": "VAR num = SUM ( 'Metric Values'[numerator] )\nVAR den = SUM ( 'Metric Values'[denominator] )\nRETURN IF ( ISBLANK ( den ), num, DIVIDE ( num, den ) )",
      "description": "The one generic measure: counts and sums (no denominator) add up; ratios sum their numerators and denominators, then divide."
    },
    {
      "name": "Metric Value (Percent)",
      "table": "Metric Values",
      "folder": "Generic",
      "format": "0.0%",
      "dax": "[Metric Value]",
      "description": "The same value shown as a percentage, for ratio metrics."
    },
    {
      "name": "Listings",
      "table": "Metric Values",
      "folder": "Headline",
      "format": "#,0",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[metric_id] = \"listings\", 'Metric Values'[dimension] = \"total\" )",
      "description": "Every listing in the snapshot."
    },
    {
      "name": "Active Listings",
      "table": "Metric Values",
      "folder": "Headline",
      "format": "#,0",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[metric_id] = \"active_listings\", 'Metric Values'[dimension] = \"total\" )",
      "description": "Listings with a review in the last 12 months."
    },
    {
      "name": "Occupancy Rate",
      "table": "Metric Values",
      "folder": "Headline",
      "format": "0.0%",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[metric_id] = \"occupancy_rate\", 'Metric Values'[dimension] = \"total\" )",
      "description": "Certified occupancy: modelled booked nights / 365, active listings."
    },
    {
      "name": "Entire Homes Over 90 Nights",
      "table": "Metric Values",
      "folder": "Headline",
      "format": "#,0",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[metric_id] = \"over_90_homes\", 'Metric Values'[dimension] = \"total\" )",
      "description": "Active short-stay entire homes modelled above 90 nights."
    },
    {
      "name": "Share Over 90 Nights",
      "table": "Metric Values",
      "folder": "Headline",
      "format": "0.0%",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[metric_id] = \"over_90_share\", 'Metric Values'[dimension] = \"total\" )",
      "description": "Over-90 entire homes as a share of active short-stay entire homes."
    },
    {
      "name": "Over 90 Nights by Borough",
      "table": "Metric Values",
      "folder": "Breakdowns",
      "format": "#,0",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[metric_id] = \"over_90_homes\", 'Metric Values'[dimension] = \"borough\" )",
      "description": "Over-90 entire homes, borough rows only."
    },
    {
      "name": "Share Over 90 by Borough",
      "table": "Metric Values",
      "folder": "Breakdowns",
      "format": "0.0%",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[metric_id] = \"over_90_share\", 'Metric Values'[dimension] = \"borough\" )",
      "description": "Over-90 share, borough rows only."
    },
    {
      "name": "Active Listings by Borough",
      "table": "Metric Values",
      "folder": "Breakdowns",
      "format": "#,0",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[metric_id] = \"active_listings\", 'Metric Values'[dimension] = \"borough\" )",
      "description": "Active listings, borough rows only."
    },
    {
      "name": "Occupancy by Borough",
      "table": "Metric Values",
      "folder": "Breakdowns",
      "format": "0.0%",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[metric_id] = \"occupancy_rate\", 'Metric Values'[dimension] = \"borough\" )",
      "description": "Certified occupancy, borough rows only."
    },
    {
      "name": "Over 90 Nights by Host Size",
      "table": "Metric Values",
      "folder": "Breakdowns",
      "format": "#,0",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[metric_id] = \"over_90_homes\", 'Metric Values'[dimension] = \"host_size\" )",
      "description": "Over-90 entire homes by how many listings the host has."
    },
    {
      "name": "Occupancy (Any Definition)",
      "table": "Metric Values",
      "folder": "Definitions",
      "format": "0.0%",
      "dax": "CALCULATE ( [Metric Value], 'Metric Values'[dimension] = \"total\", KEEPFILTERS ( CONTAINSSTRING ( 'Metric Values'[metric_id], \"occupancy\" ) ) )",
      "description": "London's value for each occupancy definition, certified or not: put Definitions[name] on the axis."
    },
    {
      "name": "Top 5 Borough Share",
      "table": "Metric Values",
      "folder": "Headline",
      "format": "0.0%",
      "dax": "VAR boroughs = FILTER ( ALL ( 'Metric Values'[member], 'Metric Values'[dimension], 'Metric Values'[metric_id] ),\n    'Metric Values'[metric_id] = \"over_90_homes\" && 'Metric Values'[dimension] = \"borough\" )\nVAR top5 = TOPN ( 5, boroughs, CALCULATE ( SUM ( 'Metric Values'[numerator] ) ), DESC )\nRETURN DIVIDE ( SUMX ( top5, CALCULATE ( SUM ( 'Metric Values'[numerator] ) ) ), [Entire Homes Over 90 Nights] )",
      "description": "Share of London's over-90 entire homes in the five boroughs with the most."
    },
    {
      "name": "Checks Passed",
      "table": "Quality Report",
      "folder": "Quality",
      "format": "0",
      "dax": "CALCULATE ( COUNTROWS ( 'Quality Report' ), 'Quality Report'[status] = \"pass\" ) + 0",
      "description": "Quality checks that passed."
    },
    {
      "name": "Checks Warned",
      "table": "Quality Report",
      "folder": "Quality",
      "format": "0",
      "dax": "CALCULATE ( COUNTROWS ( 'Quality Report' ), 'Quality Report'[status] = \"warn\" ) + 0",
      "description": "Quality checks that published with a warning."
    }
  ],
