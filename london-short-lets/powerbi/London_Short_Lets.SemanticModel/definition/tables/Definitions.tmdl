/// The metric registry (metrics.yml): name, description, whether it is certified, version and definition hash.
table Definitions

	column id
		dataType: string
		isHidden
		isKey
		summarizeBy: none
		sourceColumn: id

	column name
		dataType: string
		summarizeBy: none
		sourceColumn: name

	column description
		dataType: string
		summarizeBy: none
		sourceColumn: description

	column certified
		dataType: boolean
		summarizeBy: none
		sourceColumn: certified

	column version
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: version

	column type
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: type

	column format
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: format

	column filter
		dataType: string
		summarizeBy: none
		sourceColumn: filter

	column why_not
		dataType: string
		summarizeBy: none
		sourceColumn: why_not

	column definition_hash
		dataType: string
		summarizeBy: none
		sourceColumn: definition_hash

	partition Definitions = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "definitions.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {{"certified", each if _ = null then null else Text.Lower(_)}}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"id", type text},
				            {"name", type text},
				            {"description", type text},
				            {"certified", type logical},
				            {"version", Int64.Type},
				            {"type", type text},
				            {"format", type text},
				            {"filter", type text},
				            {"why_not", type text},
				            {"definition_hash", type text}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

