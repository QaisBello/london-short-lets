/// Entire homes modelled above 90 nights under three published review-rate assumptions.
table Sensitivity

	column review_rate
		dataType: double
		formatString: 0.0%
		summarizeBy: none
		sourceColumn: review_rate

	column label
		dataType: string
		summarizeBy: none
		sourceColumn: label

	column over_90_homes
		dataType: int64
		formatString: #,0
		summarizeBy: none
		sourceColumn: over_90_homes

	column short_let_entire_homes
		dataType: int64
		isHidden
		formatString: #,0
		summarizeBy: none
		sourceColumn: short_let_entire_homes

	column share
		dataType: double
		formatString: 0%
		summarizeBy: none
		sourceColumn: share

	partition Sensitivity = m
		mode: import
		source = ```
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "sensitivity.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    // True/TRUE/true all become true: pandas writes True, R writes TRUE
				    #"Booleans" = Table.TransformColumns(#"Blanks to Null", {}),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Booleans",
				        {
				            {"review_rate", type number},
				            {"label", type text},
				            {"over_90_homes", Int64.Type},
				            {"short_let_entire_homes", Int64.Type},
				            {"share", type number}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result
				```

